<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= esc(pageTitle) %> | <%= esc(COMPANY_KO) %></title>
<meta name="description" content="<%= esc(COMPANY_KO) %> — 보안 네트워크 구축, 클라우드 마이그레이션, 무중단 배포와 운영 자동화">
<link rel="icon" href="<%= ctx %>/assets/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;700&display=swap">
<link rel="stylesheet" href="<%= ctx %>/assets/css/style.css">
<script>document.documentElement.classList.add('js');</script>
</head>
<body>
<a class="skip" href="#main">본문 바로가기</a>
<header class="gnb" id="gnb">
  <div class="gnb-in">
    <a class="logo" href="<%= ctx %>/index.jsp#top" aria-label="<%= esc(COMPANY_KO) %> 홈">
      <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#1d1d1f"/><path d="M42 20c-3-3-7-4-11-4-7 0-12 4-12 9 0 12 26 6 26 18 0 5-5 9-13 9-5 0-9-2-12-5" fill="none" stroke="url(#lg)" stroke-width="5" stroke-linecap="round"/><defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2997ff"/><stop offset="1" stop-color="#40c8e0"/></linearGradient></defs></svg>
      SMOKE <small><%= esc(COMPANY_KO) %></small>
    </a>
    <nav class="menu" id="menu" aria-label="주 메뉴">
      <a href="<%= ctx %>/index.jsp#about">회사소개</a>
      <a href="<%= ctx %>/index.jsp#business">사업분야</a>
      <a href="<%= ctx %>/index.jsp#process">작동 방식</a>
      <a href="<%= ctx %>/index.jsp#infra">인프라</a>
      <a href="<%= ctx %>/notice.jsp" id="navNotice" <%= "notice".equals(navActive) ? "aria-current=\"page\"" : "" %>>공지 · 자료실</a>
      <a href="<%= ctx %>/index.jsp#contact" class="menu-cta">문의하기</a>
    </nav>
    <button class="burger" id="burger" aria-label="메뉴 열기" aria-expanded="false" aria-controls="menu"><span></span><span></span></button>
  </div>
</header>
<main id="main">
