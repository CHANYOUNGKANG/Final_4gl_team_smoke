# 출발점 · cicd/kubernetes/ 에 notice-blue.yaml, notice-green.yaml 로 나눠 쓴다.
# color 라벨만 바꿔 두 벌을 띄우고, ALB 대상 그룹(이우빈)이 각 Service를 가리킨다.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: notice-green
  labels: {app: notice, color: green}
spec:
  replicas: 2
  selector:
    matchLabels: {app: notice, color: green}
  template:
    metadata:
      labels: {app: notice, color: green}
    spec:
      containers:
        - name: notice
          image: <ECR_REPO>:<TAG>
          ports: [{containerPort: 8080}]
          readinessProbe:
            httpGet: {path: <공지 조회 경로>, port: 8080}
            initialDelaySeconds: 20
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: notice-green
spec:
  type: NodePort          # ALB 대상 그룹 방식에 맞춰 이우빈과 결정 (NodePort / ip 대상)
  selector: {app: notice, color: green}
  ports: [{port: 80, targetPort: 8080}]
