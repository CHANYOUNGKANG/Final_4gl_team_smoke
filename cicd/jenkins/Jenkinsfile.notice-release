// Manual test fixture release. VERIFY is read-only. No SCM trigger.
pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds(); skipDefaultCheckout(); timeout(time: 20, unit: 'MINUTES') }
  parameters {
    choice(name: 'RELEASE_MODE', choices: ['VERIFY', 'ROLLBACK_TEST', 'SWITCH'], description: 'VERIFY read-only; ROLLBACK_TEST switches and restores Blue; SWITCH leaves Green active')
    booleanParam(name: 'SEND_RELEASE_MAIL', defaultValue: false, description: 'Enable internal mail only after SMTP receipt is verified')
    booleanParam(name: 'CONFIRM_TEST_TRAFFIC_CHANGE', defaultValue: false, description: 'AWS owner approved traffic change and no concurrent edits')
  }
  environment { RELEASE_MAIL_OUTCOME = 'NOT_CONFIRMED' }
  stages {
    stage('Source') { steps { checkout scm; sh 'git rev-parse HEAD' } }
    stage('Python syntax check') {
      steps {
        sh '''
          python3 -c 'from pathlib import Path; p = Path("cicd/ansible/alb-release-verify.py"); compile(p.read_bytes(), str(p), "exec")'
          echo "RELEASE PYTHON SYNTAX OK"
        '''
      }
    }
    stage('ALB preflight on Ansible host') {
      steps {
        script {
          int rc = sh(returnStatus: true, script: '''#!/usr/bin/env bash
          set +x
          set -euo pipefail
          umask 077
          rm -f .release-mail-result.log
          mode="${RELEASE_MODE:-VERIFY}"
          case "$mode" in
            VERIFY) ;;
            SWITCH|ROLLBACK_TEST) test "$CONFIRM_TEST_TRAFFIC_CHANGE" = true ;;
            *) exit 2 ;;
          esac
          test -n "$SMOKE_ANSIBLE_HOST"
          ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes -o ConnectTimeout=10 -i /var/lib/jenkins/.ssh/smoke-deploy "ansadmin@$SMOKE_ANSIBLE_HOST" "flock -n /opt/devops/.notice-cd.lock python3 - $mode" < cicd/ansible/alb-release-verify.py | tee .release-mail-result.log
        ''')
          def lines = fileExists('.release-mail-result.log') ? readFile('.release-mail-result.log').readLines() : []
          def last = lines ? lines[-1] : ''
          if (rc == 0 && params.RELEASE_MODE == 'SWITCH' && last == 'RELEASE SWITCH OK active=green') {
            env.RELEASE_MAIL_OUTCOME = 'SWITCH_VERIFIED'
          } else if (rc == 0 && params.RELEASE_MODE == 'ROLLBACK_TEST' && last == 'RELEASE ROLLBACK TEST OK: synthetic assertion failure' && lines.any { it.startsWith('ROLLBACK VERIFIED blue=100 green=0 ') }) {
            env.RELEASE_MAIL_OUTCOME = 'SYNTHETIC_ROLLBACK_VERIFIED'
          } else if (rc == 1 && last == 'RELEASE FAILED: release failed; original Blue route verified' && lines.any { it.startsWith('ROLLBACK VERIFIED blue=100 green=0 ') }) {
            env.RELEASE_MAIL_OUTCOME = 'ROLLBACK_VERIFIED'
          } else if (lines.any { it.startsWith('RELEASE FAILED: ROLLBACK UNCONFIRMED:') }) {
            env.RELEASE_MAIL_OUTCOME = 'ROLLBACK_UNCONFIRMED'
          } else if (rc == 0 && params.RELEASE_MODE == 'VERIFY' && last.startsWith('RELEASE VERIFY OK:')) {
            env.RELEASE_MAIL_OUTCOME = 'VERIFY_ONLY'
          }
          if (rc != 0 || env.RELEASE_MAIL_OUTCOME == 'NOT_CONFIRMED') {
            error('Release failed or outcome not confirmed; inspect console')
          }
        }
      }
    }
  }
  post {
    always {
      script {
        if (params.SEND_RELEASE_MAIL && params.RELEASE_MODE != 'VERIFY') {
          def labels = [
            SWITCH_VERIFIED: '정적 시험 앱 전환 성공 (Green)',
            SYNTHETIC_ROLLBACK_VERIFIED: '정적 시험 앱 합성 롤백 검증 성공 (Blue)',
            ROLLBACK_VERIFIED: '전환 실패 / Blue 복귀 확인',
            ROLLBACK_UNCONFIRMED: '복귀 미확인 / 즉시 상태 확인',
            NOT_CONFIRMED: '실패 또는 중단 / 실제 전환·복귀 미확인'
          ]
          def outcome = labels[env.RELEASE_MAIL_OUTCOME] ?: '결과 미확인'
          try {
            mail to: 'smoke@smoke.local', from: 'jenkins@smoke.local', charset: 'UTF-8',
                 subject: "[배포] [정적시험] ${env.JOB_NAME} #${env.BUILD_NUMBER} ${outcome}",
                 body: "결과: ${outcome}\nJob 상태: ${currentBuild.currentResult}\n${env.BUILD_URL}console"
            echo 'RELEASE MAIL SEND ACCEPTED; inbox receipt separate'
          } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
            throw e
          } catch (Exception e) {
            echo 'RELEASE MAIL FAILED: release outcome unchanged; inspect SMTP configuration'
          }
        }
      }
    }
  }
}
