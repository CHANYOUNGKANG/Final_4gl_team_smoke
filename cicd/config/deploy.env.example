# 예시 값만 둔다. 실제 값은 Jenkins → Manage Jenkins → System → Global properties → Environment variables 에 넣는다.
# 이 파일을 복사한 실제 *.env 파일은 .gitignore로 제외된다.
# 서브넷 배치는 docs/architecture/ip-plan.md (Jenkins: 퍼블릭 10.100.1.0/24, Ansible·EKS 워커: 프라이빗 앱 10.100.11·12.0/24)

APP_DIR=app
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=000000000000
ECR_REPO=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/notice
EKS_CLUSTER=smoke-eks
K8S_NAMESPACE=notice
EKS_ASG=smoke-workers-asg   # 워커 장애 런북에서 사용 (docs/runbooks/worker-failure.md)
DEPLOY_HOST=ansible.example.internal   # 실제 값: 프라이빗 앱 서브넷의 Ansible EC2 사설 주소
DEPLOY_PORT=22
NOTICE_URL=https://notice.example.com
GREEN_CHECK_URL=https://green.notice.example.com
SNS_TOPIC_ARN=arn:aws:sns:ap-northeast-2:000000000000:smoke-ops-alerts
APP_PORT=8080          # Tomcat 컨테이너 포트 = ALB 대상 그룹 포트 (허용표: ALB SG → 노드 SG 8080)
DB_HOST=db.smoke.internal
CACHE_HOST=cache.smoke.internal
