# /etc/tomcat-smoke.env (chmod 600, root 소유) — 실제 값은 서버에만 둔다
DB_HOST=DATA_HOST
DB_PORT=3306
DB_NAME=smoke_board
DB_USER=smoke
DB_PASS=<DB_PASSWORD>
UPLOAD_DIR=/var/smoke/attach
# 온프레미스 JSP 공지 앱(server/onprem-notice-jsp) 전용
WRITE_KEY=<openssl rand -hex 16 로 생성>
CHECK_KEY=<openssl rand -hex 16 로 생성>

# ---- 11/27 팀 표준 앱(app/, boarddb) 기준 — 키 이름만, 값은 서버에만 ----
# DB_NAME=boarddb  DB_PASSWORD=<DB_PASSWORD>  DB_DDL=validate  APP_SEED=false
# APP_STORAGE_DIR=/var/smoke/attach
# ADMIN_KEY=<openssl rand -hex 16>   # 없으면 글쓰기 잠금
# MAIL_TO=smoke@smoke.local   SMTP_HOST=127.0.0.1   SMTP_PORT=25
# COMPANY_ADDR=<회사 주소>   COMPANY_TEL=<대표 번호>   COMPANY_MAIL=smoke@smoke.local
